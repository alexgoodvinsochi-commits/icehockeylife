---
import { Image } from 'astro:assets';
import skater from '../assets/cutouts/skater.png';
import { camp, contacts } from '../data/camp';
import { t } from '../lib/typo';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__ice wrap">
    <div class="hero__copy">
      <h1 class="hero__title display" id="hero-title">{t('Зимние хоккейные сборы в Сириусе')}</h1>

      <p class="hero__dates">
        <span class="hero__days num" aria-hidden="true">4–10</span>
        <span class="hero__month"><span class="visually-hidden">4–10 </span>января 2027<br />{camp.arena}</span>
      </p>

      <p class="hero__lead">
        {t('Семь дней: 9 часов на льду и 16 вне льда, группы по 5–6 человек. Ведёт главный тренер Максим Крейдиков.')}
      </p>

      <div class="hero__price">
        <p data-until={camp.price.earlyUntil}>
          <b class="num">43&nbsp;680&nbsp;₽</b>
          <span>{t('первым 15 участникам, которые забронируют место до 8 ноября включительно. С 9 ноября —')} <span class="nowrap">48&nbsp;860&nbsp;₽</span></span>
        </p>
        <p data-from={camp.price.earlyUntil} hidden>
          <b class="num">48&nbsp;860&nbsp;₽</b>
          <span>{t('за тренировки. Вратарям — скидка, можно оплатить в рассрочку.')}</span>
        </p>
      </div>

      <div class="hero__cta">
        <a class="btn btn--red" href="#zapis">Записаться</a>
        <p class="hero__call">
          {t('или позвоните Олегу, координатору:')}
          <a class="nowrap" href={`tel:${contacts.coordinator.tel}`}>{contacts.coordinator.phone}</a>
        </p>
      </div>
    </div>

    <div class="hero__art" aria-hidden="true">
      <svg class="hero__circle" viewBox="-560 -560 1120 1120">
        <circle r="450" fill="none" stroke="var(--c-red-line)" stroke-width="7"></circle>
        <g stroke="var(--c-red-line)" stroke-width="7">
          <line x1="-85" y1="-450" x2="-85" y2="-520"></line><line x1="85" y1="-450" x2="85" y2="-520"></line>
          <g class="hero__hash-b"><line x1="-85" y1="450" x2="-85" y2="520"></line><line x1="85" y1="450" x2="85" y2="520"></line></g>
          <path d="M-60 -32 h-54 M-60 -32 v-54 M60 -32 h54 M60 -32 v-54 M-60 32 h-54 M-60 32 v54 M60 32 h54 M60 32 v54" fill="none"></path>
        </g>
        <circle r="30" fill="var(--c-red-line)"></circle>
      </svg>
      <Image
        class="hero__skater"
        src={skater}
        alt=""
        widths={[480, 720, 1000, 1338]}
        sizes="(min-width: 1100px) 46vw, 92vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero { position: relative; padding-block: clamp(16px, 3vw, 40px) clamp(40px, 6vw, 96px); overflow: clip; }
  .hero__ice { display: grid; grid-template-columns: minmax(0, 11fr) minmax(0, 10fr); gap: clamp(12px, 3vw, 48px); align-items: center; }

  .hero__title { font-size: clamp(2.9rem, 1.5rem + 4vw, 5.9rem); color: var(--c-blue-deep); max-width: 15ch; }

  .hero__dates { display: flex; align-items: flex-end; gap: clamp(12px, 1.4vw, 20px); margin-top: clamp(16px, 2.2vw, 30px); }
  .hero__days {
    flex: none; white-space: nowrap;
    font-family: var(--f-display); font-weight: 900; line-height: .78; letter-spacing: -.01em;
    font-size: clamp(6rem, 3.4rem + 8vw, 11rem); color: var(--c-red-line);
  }
  .hero__month {
    font-family: var(--f-display); font-weight: 800; line-height: .98;
    font-size: clamp(1.55rem, 1.05rem + 1.7vw, 2.7rem); color: var(--c-ink); padding-bottom: .08em;
  }

  .hero__lead { margin-top: clamp(16px, 1.8vw, 24px); font-size: var(--fs-lead); line-height: 1.45; max-width: 36ch; color: var(--c-ink-2); }

  .hero__price { margin-top: 18px; }
  .hero__price p { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; }
  .hero__price b { font-family: var(--f-display); font-weight: 900; font-size: clamp(2.1rem, 1.6rem + 1.6vw, 3rem); line-height: 1; color: var(--c-ink); }
  .hero__price span { color: var(--c-ink-2); max-width: 36ch; }

  .hero__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 24px; }
  .hero__call { color: var(--c-ink-2); max-width: 30ch; line-height: 1.35; }
  .hero__call a { color: var(--c-ink); font-weight: 600; }

  .hero__art { position: relative; align-self: stretch; min-height: clamp(320px, 42vw, 640px); }
  .hero__circle { position: absolute; width: 112%; left: -4%; top: 50%; translate: 0 -50%; }
  .hero__skater { position: absolute; left: 50%; top: 50%; translate: -48% -50%; width: 112%; max-width: none; height: auto; }

  @media (max-width: 980px) {
    .hero__ice { grid-template-columns: 1fr; gap: 0; }
    .hero__copy { display: contents; }
    .hero__title { order: -2; }
    /* the kid skates out of the circle, in front of the giant dates */
    /* layers: circle (back) → dates → skater (front); the art box itself must not create a stacking context */
    .hero__art { order: -1; min-height: 0; aspect-ratio: 1.3; margin: 18px calc(-1 * var(--gutter)) 0; position: relative; pointer-events: none; }
    .hero__circle { width: 78%; left: 13%; translate: 0 -52%; z-index: 0; }
    .hero__skater { width: 86%; translate: -40% -56%; z-index: 2; }
    .hero__dates { position: relative; z-index: 1; margin-top: -11%; }
    .hero__hash-b { display: none; } /* would cross the month line below */
  }
  /* phones: a flatter art box so the price and the button fit the first screen of Safari (≈714 px) */
  @media (max-width: 480px) {
    .hero__art { aspect-ratio: 1.7; margin-top: 10px; }
    .hero__circle { width: 64%; left: 20%; translate: 0 -52%; }
    .hero__skater { width: 72%; translate: -36% -55%; }
    .hero__dates { margin-top: -8%; }
    .hero__lead { margin-top: 12px; }
    .hero__price { margin-top: 12px; }
    .hero__cta { margin-top: 16px; }
  }
</style>
