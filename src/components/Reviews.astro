---
import { reviews } from '../data/reviews';
import { t } from '../lib/typo';

const lead = reviews.find((r) => r.by === 'Мама Дани')!;
const others = [...reviews.filter((r) => r.featured && r !== lead), ...reviews.filter((r) => !r.featured)];
const FIRST = 3;
---

<section class="rev section" id="otzyvy" aria-labelledby="rev-title">
  <div class="wrap">
    <div class="rev__head">
      <h2 class="rev__title display" id="rev-title">{t('Что пишут родители')}</h2>
      <p class="rev__note">{t(`${reviews.length} отзывов из комментариев, постов, сообщений и сторис родителей. Мы убрали эмодзи и лишние «!», исправили опечатки и пунктуацию, упоминания аккаунтов заменили названием сборов и именем тренера.`)}</p>
    </div>

    <figure class="rev__lead">
      <blockquote><p>{t(lead.text)}</p></blockquote>
      <figcaption>{t(lead.by)}{lead.note && <span>{t(lead.note)}</span>}</figcaption>
    </figure>

    <ul class="rev__wall" role="list" data-rev>
      {
        others.map((r, i) => (
          <li class="msg" hidden={i >= FIRST} data-more={i >= FIRST ? '' : undefined}>
            <blockquote><p>{t(r.text)}</p></blockquote>
            <p class="msg__by">
              <b>{t(r.by)}</b>
              {r.note && <span>{t(r.note)}</span>}
            </p>
          </li>
        ))
      }
    </ul>
    <button class="rev__more" type="button" data-rev-more>Показать все отзывы — ещё {others.length - FIRST}</button>
  </div>
</section>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-rev-more]');
  btn?.addEventListener('click', () => {
    const hidden = [...document.querySelectorAll<HTMLElement>('[data-rev] [data-more]')];
    hidden.forEach((li) => (li.hidden = false));
    hidden[0]?.querySelector('p')?.setAttribute('tabindex', '-1');
    (hidden[0]?.querySelector('p') as HTMLElement | null)?.focus({ preventScroll: true });
    btn.remove();
  });
</script>

<style>
  .rev { background: var(--c-board); }
  .rev__head { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 20px clamp(24px, 5vw, 80px); align-items: end; }
  .rev__title { font-size: var(--fs-h2s); color: var(--c-blue-deep); }
  .rev__note { color: var(--c-ink-2); max-width: 44ch; }

  .rev__lead { margin-top: clamp(28px, 4vw, 56px); }
  .rev__lead blockquote p { font-family: var(--f-display); font-weight: 700; font-size: clamp(2rem, 1.3rem + 2.6vw, 3.6rem); line-height: 1.02; color: var(--c-ink); max-width: 10.4em; }
  .rev__lead figcaption { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 4px 12px; font-weight: 600; color: var(--c-ink-2); }
  .rev__lead figcaption span { font-weight: 400; color: var(--c-ink-3); }

  .rev__wall { columns: 2 340px; column-gap: clamp(14px, 2vw, 28px); margin-top: clamp(32px, 5vw, 64px); }
  /* messages as they are: text, author, where it was written — no cards */
  .msg { break-inside: avoid; padding: 20px 0 22px; border-top: 1px solid var(--c-hair); }
  .msg blockquote p { line-height: 1.55; color: var(--c-ink); }
  .msg__by { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: var(--fs-small); color: var(--c-ink-2); }
  .msg__by b { color: var(--c-ink); }
  .msg__by span { color: var(--c-ink-3); }

  .rev__more {
    display: block; margin: 8px auto 0; padding: 14px 26px; border-radius: var(--r-s);
    border: 2px solid var(--c-ink); background: none;
    font-weight: 600; font-size: 1rem;
  }
  @media (hover: hover) { .rev__more:hover { background: var(--c-ink); color: #fff; } }

  @media (max-width: 860px) {
    .rev__head { grid-template-columns: 1fr; }
  }
</style>
