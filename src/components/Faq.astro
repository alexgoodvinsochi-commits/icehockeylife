---
import { faq } from '../data/faq';
import { contacts } from '../data/camp';
import { t } from '../lib/typo';
import { withPhones } from '../lib/rich';
---

<section class="faq section" id="voprosy" aria-labelledby="faq-title">
  <div class="wrap faq__grid">
    <div class="faq__side">
      <h2 class="faq__title display" id="faq-title">Вопросы<br />родителей</h2>
      <p class="faq__ask">
        Не нашли ответа — спросите координатора сборов:
        <a href={`tel:${contacts.coordinator.tel}`} class="nowrap">{contacts.coordinator.name}, {contacts.coordinator.phone}</a>
      </p>
    </div>
    <div class="faq__list">
      {
        faq.map((item, i) => (
          <details class="faq__item" open={i === 0} data-until={item.until} data-from={item.from} hidden={!!item.from}>
            <summary>
              <span class="faq__dot" aria-hidden="true" />
              <span class="faq__q">{t(item.q)}</span>
            </summary>
            <div class="faq__a">
              {item.a.map((p) => <p set:html={withPhones(p)} />)}
              {item.link && <p class="faq__link"><a href={item.link.href}>{item.link.label}</a></p>}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(28px, 5vw, 96px); align-items: start; }
  .faq__side { position: sticky; top: calc(var(--header-h) + 32px); }
  .faq__title { font-size: var(--fs-h2s); color: var(--c-blue-deep); }
  .faq__ask { margin-top: 24px; max-width: 26ch; color: var(--c-ink-2); }
  .faq__ask a { color: var(--c-ink); font-weight: 600; }

  .faq__list { border-top: 2px solid var(--c-ink); }
  .faq__item { border-bottom: 1px solid var(--c-hair-2); }
  .faq__item summary {
    list-style: none; cursor: pointer;
    display: grid; grid-template-columns: 26px 1fr; gap: 16px; align-items: start;
    padding: 22px 0;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__q { font-size: clamp(1.15rem, 1rem + .6vw, 1.5rem); font-weight: 600; line-height: 1.25; }
  .faq__item summary:hover .faq__q { color: var(--c-blue-line); }

  /* plus that turns into a minus: says «this opens» without inventing a rink metaphor for a control */
  .faq__dot {
    width: 18px; height: 18px; margin-top: 6px;
    background:
      linear-gradient(var(--c-ink), var(--c-ink)) center / 100% 2px no-repeat,
      linear-gradient(var(--c-ink), var(--c-ink)) center / 2px 100% no-repeat;
    transition: background-size .2s var(--ease-out);
  }
  .faq__item[open] .faq__dot { background-size: 100% 2px, 2px 0; }

  .faq__a { padding: 0 0 26px 42px; max-width: 62ch; color: var(--c-ink-2); }
  .faq__a > * + * { margin-top: .75em; }
  .faq__a :global(a) { color: var(--c-ink); font-weight: 600; }
  .faq__link a { color: var(--c-blue-line) !important; padding-block: 10px; }

  @media (max-width: 860px) {
    .faq__grid { grid-template-columns: 1fr; }
    .faq__side { position: static; }
    .faq__item summary { grid-template-columns: 18px 1fr; gap: 12px; }
    .faq__a { padding-left: 30px; }
  }
</style>
