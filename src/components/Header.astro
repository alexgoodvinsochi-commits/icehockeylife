---
import Mark from './Mark.astro';
import { camp, contacts } from '../data/camp';
import { t } from '../lib/typo';

const nav = [
  { href: '#programma', label: 'Программа' },
  { href: '#trenery', label: 'Тренеры' },
  { href: '#cena', label: 'Стоимость' },
  { href: '#roditelyam', label: 'Родителям' },
  { href: '#otzyvy', label: 'Отзывы' },
  { href: '#voprosy', label: 'Вопросы' },
  { href: '#kontakty', label: 'Контакты' },
];
// the header is shared with the legal pages: there every anchor has to lead back to the home page
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const onHome = Astro.url.pathname === base || Astro.url.pathname === base.slice(0, -1);
const to = (hash: string) => (onHome || hash === '#kontakty' ? hash : base + hash);
---

<header class="hdr" data-hdr>
  <div class="hdr__in wrap">
    <a class="hdr__brand" href={onHome ? '#top' : base} aria-label={onHome ? 'Ice Hockey Life — наверх' : 'Ice Hockey Life — на главную'}>
      <Mark size={36} />
      <span class="hdr__word">Ice Hockey Life</span>
    </a>

    <nav class="hdr__nav" aria-label="Разделы">
      <ul role="list">
        {nav.map((n) => <li><a href={to(n.href)}>{n.label}</a></li>)}
      </ul>
    </nav>

    <a class="hdr__cta" href={to('#zapis')} data-until={camp.overAfter}>Записаться</a>

    <button class="hdr__burger" type="button" data-sheet-open="menu" aria-label="Меню" aria-haspopup="dialog">
      <span></span><span></span>
    </button>
  </div>
</header>

<script>
  // highlight the section the reader is in
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.hdr__nav a')].filter((a) => a.pathname === location.pathname);
  const sections = links.map((a) => document.getElementById(a.hash.slice(1))).filter((s): s is HTMLElement => !!s);
  // every top-level section is watched, so passing a section that is not in the menu clears the highlight
  const watched = [...document.querySelectorAll<HTMLElement>('main > section, footer')];
  if ('IntersectionObserver' in window && sections.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => a.setAttribute('aria-current', String(a.hash === `#${e.target.id}`)));
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    watched.forEach((s) => io.observe(s));
  }
</script>

<dialog class="menu" id="menu" data-sheet data-sheet-nohistory aria-label="Меню">
  <div class="menu__panel">
    <div class="menu__top">
      <span class="menu__h">Разделы</span>
      <button class="menu__close" type="button" data-sheet-close aria-label="Закрыть меню">×</button>
    </div>
    <ul class="menu__list" role="list">
      {nav.filter((n) => n.href !== '#kontakty').map((n) => <li><a href={to(n.href)} data-sheet-close>{n.label}</a></li>)}
      <li><a href={to('#zapis')} data-sheet-close>Записаться</a></li>
    </ul>
    <div class="menu__contacts">
      <a href={`tel:${contacts.coordinator.tel}`}>
        <span>{t(`${contacts.coordinator.name}, ${contacts.coordinator.role}: ${contacts.coordinator.remit}`)}</span>
        <b>{contacts.coordinator.phone}</b>
      </a>
      <a href={`tel:${contacts.headCoach.tel}`}>
        <span>{t(`${contacts.headCoach.name}, ${contacts.headCoach.role}: ${contacts.headCoach.remit}`)}</span>
        <b>{contacts.headCoach.phone}</b>
      </a>
    </div>
  </div>
</dialog>

<style>
  .hdr {
    position: sticky; top: 0; z-index: 40;
    background: var(--c-board);
    /* the board: white face, yellow kick plate at the bottom */
    box-shadow: inset 0 -3px 0 var(--c-kick), 0 1px 0 var(--c-hair);
  }
  .hdr__in { display: flex; align-items: center; gap: 24px; height: var(--header-h); }
  .hdr__brand { display: flex; align-items: center; gap: 10px; min-height: 44px; text-decoration: none; color: var(--c-blue-deep); --mark-bg: var(--c-board); }
  .hdr__word {
    font-family: var(--f-display); font-weight: 850; font-size: 1.35rem; white-space: nowrap;
    letter-spacing: .02em; text-transform: uppercase; line-height: 1;
  }
  .hdr__nav { margin-left: auto; }
  .hdr__nav ul { display: flex; gap: clamp(14px, 1.6vw, 28px); }
  .hdr__nav a {
    font-family: var(--f-display); font-weight: 700; font-size: 1.06rem; letter-spacing: .04em;
    text-transform: uppercase; text-decoration: none; color: var(--c-ink); padding: 8px 0;
    background: linear-gradient(var(--c-red-line), var(--c-red-line)) 0 100% / 0 2px no-repeat;
  }
  .hdr__nav a[aria-current='true'] { background-size: 100% 2px; }
  @media (hover: hover) { .hdr__nav a { transition: background-size .2s var(--ease-out); } .hdr__nav a:hover { background-size: 100% 2px; } }
  .hdr__cta {
    flex: none;
    font-family: var(--f-display); font-weight: 800; font-size: 1.08rem; letter-spacing: .05em; text-transform: uppercase;
    text-decoration: none; color: #fff; background: var(--c-red-line);
    padding: 11px 18px 10px; border-radius: var(--r-s);
    transition: background-color .2s;
  }
  .hdr__cta:hover { background: var(--c-red-deep); }
  .hdr__burger {
    display: none; width: 44px; height: 44px; margin-right: -10px;
    border: 0; background: none; position: relative;
  }
  .hdr__burger span { position: absolute; left: 11px; right: 11px; height: 2.5px; background: var(--c-ink); border-radius: 2px; }
  .hdr__burger span:first-child { top: 17px; }
  .hdr__burger span:last-child { top: 25px; }

  @media (max-width: 1080px) {
    .hdr__nav { display: none; }
    .hdr__cta { margin-left: auto; }
    .hdr__burger { display: block; }
  }
  @media (max-width: 440px) {
    .hdr__in { gap: 12px; }
    .hdr__word { font-size: 1.12rem; }
  }
  @media (max-width: 360px) {
    .hdr__word { display: none; }
    .hdr__cta { padding: 10px 13px 9px; font-size: 1rem; }
  }
  /* phones: «Записаться» steps aside while another sign-up button is on screen (the hero's, the bottom bar's or
     the form itself); once the bar is up, the header slides away while reading down and returns on the way up */
  @media (max-width: 760px) {
    .hdr { transition: translate .22s var(--ease-out); }
    .hdr__cta { transition: opacity .2s, visibility .2s; }
    :global(html.hdr-cta-off) .hdr__cta { opacity: 0; visibility: hidden; }
    :global(html.has-mbar.scroll-down) .hdr:not(:focus-within) { translate: 0 -100%; }
  }

  /* mobile menu sheet */
  .menu {
    margin: 0; inset: 0 0 0 auto; height: 100dvh; max-height: none; width: min(100%, 420px);
    border: 0; padding: 0; background: var(--c-blue-deep); color: #fff;
  }
  .menu::backdrop { background: rgb(11 30 63 / .45); }
  .menu[open] { animation: menu-in .32s var(--ease-out); }
  @keyframes menu-in { from { transform: translateX(100%); } }
  .menu__panel {
    display: flex; flex-direction: column; min-height: 100%;
    padding: 18px max(var(--gutter), env(safe-area-inset-right)) max(28px, env(safe-area-inset-bottom)) var(--gutter);
  }
  .menu__top { display: flex; justify-content: space-between; align-items: center; color: var(--c-crease); }
  .menu__h { font-weight: 600; }
  .menu__close { width: 44px; height: 44px; border: 0; background: none; color: #fff; font-size: 2.2rem; line-height: 1; margin-right: -8px; }
  .menu__list { margin-top: 16px; }
  .menu__list a {
    display: block; padding: 10px 0; text-decoration: none;
    font-family: var(--f-display); font-weight: 850; font-size: 2.2rem; line-height: 1.05;
    border-bottom: 1px solid rgb(255 255 255 / .14);
  }
  .menu__list li:last-child a { color: var(--c-kick); }
  .menu__contacts { margin-top: auto; display: grid; gap: 14px; padding-top: 28px; }
  .menu__contacts a { text-decoration: none; display: grid; gap: 4px; }
  .menu__contacts span { color: var(--c-crease); font-size: .85rem; }
  .menu__contacts b { font-size: 1.35rem; font-weight: 600; }
</style>
