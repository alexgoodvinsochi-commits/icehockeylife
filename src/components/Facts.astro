---
import { camp, rub, regularFrom } from '../data/camp';
import { withPhones } from '../lib/rich';

// one place where a parent can compare the camp with others: the facts, nothing else
// every value ends with a full stop, so the link after it reads as a link, not as the last word
const stop = (s: string) => (/[.!?…]$/.test(s) ? s : `${s}.`);
type Row = { k: string; v: string; link?: { href: string; label: string }; until?: string; from?: string };
const rows: Row[] = [
  { k: 'Даты', v: `${camp.datesHuman} года, семь дней. Точное расписание пришлём за 2 недели до сборов`, until: camp.overAfter },
  { k: 'Даты', v: `${camp.datesHuman} года, семь дней`, from: camp.overAfter },
  { k: 'Где', v: `${camp.arena}, Сириус (Сочи) — хоккейная арена Олимпиады-2014` },
  {
    k: 'Формат',
    v: 'Без проживания: ребёнок живёт с вами. На тренировки его привозят и забирают родители, а между тренировками можно оставить на дневное пребывание с питанием (за доплату)',
    link: { href: '#roditelyam', label: 'Как устроен день' },
  },
  { k: 'Возраст', v: 'Группы по возрасту и уровню. Подойдут ли сборы вашему ребёнку, подскажет главный тренер Максим Сергеевич: +7 938 438-91-63' },
  {
    k: 'Тренировки',
    v: `${camp.hoursIce} часов на льду и ${camp.hoursOffIce} часов вне льда: ОФП и СФП, бросковая зона, растяжка и миофасциальный релиз, гимнастика, координация, занятия с психологом, видеоанализ`,
    link: { href: '#programma', label: 'Программа' },
  },
  { k: 'Группы', v: `${camp.groupSize} человек, за каждой группой закреплён тренер`, link: { href: '#trenery', label: 'Тренеры' } },
  { k: 'Вратари', v: 'Отдельная программа с тренерами вратарей и скидка' },
  {
    k: 'Стоимость',
    v: `${rub(camp.price.early)} для первых ${camp.price.earlySeats} участников, которые забронируют место до ${camp.price.earlyUntilHuman} включительно, затем ${rub(camp.price.regular)}. Только тренировки, можно в рассрочку`,
    link: { href: '#cena', label: 'Цены и условия' },
    until: camp.price.earlyUntil,
  },
  {
    k: 'Стоимость',
    v: `${rub(camp.price.regular)} — только тренировки, можно в рассрочку`,
    link: { href: '#cena', label: 'Цены и условия' },
    from: regularFrom,
  },
  { k: 'Каждому', v: 'Форма для ОФП, фирменные джерси, шапка и подарки от Ice Hockey Life' },
  { k: 'Жильё', v: `Проживание и питание не входят в стоимость. В отеле-партнёре «${camp.hotel.name}» для участников специальная цена — её назовёт координатор` },
];
---

<section class="facts" aria-labelledby="facts-title">
  <div class="wrap facts__grid">
    <h2 class="facts__title display" id="facts-title">Коротко о&nbsp;сборах</h2>
    <dl class="facts__list">
      {
        rows.map((r) => (
          <div class="facts__row" data-until={r.until} data-from={r.from} hidden={!!r.from}>
            <dt>{r.k}</dt>
            <dd>
              <Fragment set:html={withPhones(stop(r.v))} />
              {r.link && <a class="facts__more" href={r.link.href}>{r.link.label}</a>}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .facts { padding-block: clamp(8px, 2vw, 24px) var(--section); }
  .facts__grid { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: clamp(20px, 4vw, 64px); align-items: start; }
  .facts__title { font-size: var(--fs-h3); color: var(--c-blue-deep); padding-top: 14px; }
  .facts__list { border-top: 3px solid var(--c-ink); display: grid; grid-template-columns: 1fr 1fr; column-gap: clamp(20px, 3vw, 48px); }
  .facts__row { display: grid; grid-template-columns: 7.5em 1fr; gap: 14px; padding: 14px 0; border-bottom: 1px solid var(--c-hair-2); }
  .facts__row dt { font-weight: 600; color: var(--c-ink); }
  .facts__row dd { margin: 0; color: var(--c-ink-2); }
  .facts__row a { color: var(--c-blue-line); font-weight: 600; }
  .facts__row dd :global(a[href^='tel:']) { color: var(--c-ink); font-weight: 600; }
  .facts__row dd > a { white-space: nowrap; }
  .facts__more { display: table; margin-top: 4px; padding-block: 4px; }

  @media (min-width: 901px) {
    .facts__list { display: block; columns: 2; column-gap: clamp(20px, 3vw, 48px); }
    .facts__row { break-inside: avoid; }
    .facts__title { position: sticky; top: calc(var(--header-h) + 24px); }
  }
  @media (max-width: 900px) {
    .facts__grid { grid-template-columns: 1fr; }
    .facts__title { padding-top: 0; }
    .facts__list { grid-template-columns: 1fr; }
  }
  @media (max-width: 420px) {
    .facts__row { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
