---
import { Image, getImage } from 'astro:assets';
import { photos } from '../data/photos';

// every photo in src/assets/photos is processed at build time; spare ones live in photos/spare/ so they
// are not built and shipped (an imported image always lands in dist as an original file)
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', { eager: true });
const load = (slug: string) => files[`../assets/photos/${slug}.jpg`]?.default;

// curated order: the story of a week, alternating ice and off-ice, people first
// photos already used elsewhere on the page (program, price, coaches, video poster, cut-outs) are not repeated;
// 24 photos = two 12-photo blocks that tile the 6-column grid exactly
// big tiles (positions 0, 6, 12, 18) are always hockey
const order = [
  'huddle-coaches', 'smiling-boy-closeup', 'two-kids-skating', 'stretching-outdoor', 'goalies-huddle', 'ball-game-indoor',
  'two-kids-battle', 'gymnastics-bridge', 'wide-stance-boards', 'mfr-roller', 'two-kids-smiling', 'kids-at-table',
  'little-skaters', 'coach-with-goalie', 'stickhandling-office', 'hands-up-game', 'two-goalies', 'boy-red-jersey',
  'goalie-butterfly', 'workout-mountains', 'video-analysis', 'locker-room', 'goalies-net', 'coaches-at-arena',
];
const meta = Object.fromEntries(photos.map((p) => [p.file, p]));
const loaded = await Promise.all(
  order.map(async (f) => {
    const src = load(f);
    if (!src) return null;
    const full = await getImage({ src, widths: [960, 1680], format: 'webp' });
    return { file: f, src, alt: meta[f]?.alt ?? '', caption: meta[f]?.caption, full };
  }),
);
const items = loaded.filter((x): x is NonNullable<typeof x> => !!x);
const FIRST = 12;
const isBig = (i: number) => i % 12 === 0 || i % 12 === 6;
const plural = (n: number, forms: [string, string, string]) =>
  forms[n % 10 === 1 && n % 100 !== 11 ? 0 : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? 1 : 2];
---

<section class="gal section" id="foto" aria-labelledby="gal-title">
  <div class="wrap">
    <div class="gal__head">
      <h2 class="gal__title display" id="gal-title">{items.length}&nbsp;{plural(items.length, ['фотография', 'фотографии', 'фотографий'])} с&nbsp;прошлых смен</h2>
      <p class="gal__note">Лёд, зал, растяжка и&nbsp;перерывы между тренировками.</p>
    </div>
    <ul class="gal__grid" role="list" data-gal>
      {
        items.map((it, i) => (
          <li class:list={['gal__item', i % 12 === 0 && 'gal__item--big', i % 12 === 6 && 'gal__item--big gal__item--right']} hidden={i >= FIRST} data-more={i >= FIRST ? '' : undefined}>
            <a
              href={it.full.src}
              data-lightbox
              data-caption={it.caption}
              data-srcset={it.full.srcSet.attribute}
              data-sizes="100vw"
            >
              {isBig(i) ? (
                <Image src={it.src} alt={it.alt} widths={[560, 900, 1260, 1680]} sizes="(min-width: 761px) 62vw, 92vw" loading="lazy" />
              ) : (
                <Image src={it.src} alt={it.alt} widths={[360, 560, 840]} sizes="(min-width: 761px) 31vw, 46vw" loading="lazy" />
              )}
            </a>
          </li>
        ))
      }
    </ul>
    <button class="gal__more" type="button" data-gal-more>Показать все {items.length} фото</button>
  </div>

  <dialog class="lb" data-lightbox-dialog aria-label="Просмотр фотографий">
    <img data-lb-img alt="" />
    <div class="lb__bar">
      <span class="lb__count num" data-lb-count aria-live="polite"></span>
      <p class="lb__cap" data-lb-caption></p>
      <div class="lb__nav">
        <button type="button" data-lb-prev aria-label="Предыдущее фото">←</button>
        <button type="button" data-lb-next aria-label="Следующее фото">→</button>
        <button type="button" data-lb-close aria-label="Закрыть">×</button>
      </div>
    </div>
  </dialog>
</section>

<script>
  import { initLightbox } from '../scripts/lightbox';
  initLightbox();
  const more = document.querySelector<HTMLButtonElement>('[data-gal-more]');
  more?.addEventListener('click', () => {
    const hidden = [...document.querySelectorAll<HTMLElement>('[data-gal] [data-more]')];
    hidden.forEach((li) => (li.hidden = false));
    more.remove();
    // keyboard users continue from the first new photo, not from the top of the page
    hidden[0]?.querySelector<HTMLAnchorElement>('a')?.focus();
  });
</script>

<style>
  /* swipes reach the script as pointer events instead of being taken over by the browser */
  .lb { touch-action: pan-y pinch-zoom; }
  .gal__head { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; margin-bottom: clamp(20px, 3vw, 40px); }
  .gal__title { font-size: var(--fs-h2s); color: var(--c-blue-deep); }
  .gal__note { max-width: 32ch; color: var(--c-ink-2); }
  /* 12-photo blocks tile the 6-column grid exactly: big left + 2 small, 3 small, big right + 2 small, 3 small */
  .gal__grid { display: grid; grid-template-columns: repeat(6, 1fr); grid-auto-flow: dense; gap: clamp(6px, .8vw, 12px); }
  .gal__item { grid-column: span 2; aspect-ratio: 3 / 2; }
  .gal__item--big { grid-column: span 4; grid-row: span 2; aspect-ratio: auto; }
  .gal__item--right { grid-column: 3 / span 4; }
  .gal__item a { display: block; height: 100%; border-radius: var(--r-s); overflow: hidden; background: var(--c-ice-2); }
  .gal__item img { width: 100%; height: 100%; object-fit: cover; }
  @media (hover: hover) { .gal__item a:hover { outline: 2px solid var(--c-ink); outline-offset: 2px; } }
  .gal__more {
    display: block; margin: clamp(20px, 3vw, 32px) auto 0; padding: 14px 26px; border-radius: var(--r-s);
    border: 2px solid var(--c-ink); background: none;
    font-weight: 600; font-size: 1rem;
  }
  @media (hover: hover) { .gal__more:hover { background: var(--c-ink); color: #fff; } }

  @media (max-width: 760px) {
    .gal__grid { grid-template-columns: repeat(2, 1fr); }
    .gal__item { grid-column: span 1; }
    .gal__item--big, .gal__item--right { grid-column: 1 / -1; grid-row: auto; aspect-ratio: 3 / 2; }
  }

  .lb { border: 0; padding: 0; margin: 0; width: 100vw; height: 100dvh; max-width: none; max-height: none; background: rgb(6 12 24 / .96); color: #fff; }
  .lb[open] { display: grid; grid-template-rows: 1fr auto; }
  .lb img { width: 100%; height: 100%; object-fit: contain; padding: 12px; min-height: 0; }
  .lb__bar { display: grid; grid-template-columns: auto 1fr auto; gap: 16px; align-items: center; padding: 12px var(--gutter) max(14px, env(safe-area-inset-bottom)); }
  .lb__count { font-variant-numeric: tabular-nums; color: rgb(255 255 255 / .8); }
  .lb__cap { font-size: var(--fs-small); color: rgb(255 255 255 / .8); }
  .lb__nav { display: flex; gap: 6px; }
  .lb__nav button { width: 48px; height: 48px; border-radius: 50%; border: 1.5px solid rgb(255 255 255 / .35); background: none; color: #fff; font-size: 1.3rem; }
  .lb__nav button:hover { background: rgb(255 255 255 / .12); }
  @media (max-width: 560px) {
    .lb__bar { grid-template-columns: auto 1fr; }
    .lb__cap { grid-column: 1 / -1; grid-row: 1; }
    .lb__nav { justify-self: end; }
  }
</style>
