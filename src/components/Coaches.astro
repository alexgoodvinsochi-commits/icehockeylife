---
import { Image } from 'astro:assets';
import { coaches, specialists, type Person } from '../data/staff';
import { camp, contacts } from '../data/camp';
import { t } from '../lib/typo';
import BioSheet from './BioSheet.astro';
import lineup from '../assets/photos/coaches-lineup-ice.jpg';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/staff/*.png', { eager: true });
const portrait = (slug: string) => files[`../assets/staff/${slug}.png`].default;

const head = coaches.filter((c) => c.group === 'head');
const rest = coaches.filter((c) => c.group !== 'head');
const withBio = [...coaches, ...specialists].filter((p) => p.bio);

// the card link says what the sheet holds instead of a generic «Подробнее»
const more = (p: Person) =>
  p.bio?.some((s) => s.title.startsWith('Воспитанники'))
    ? 'Карьера и воспитанники'
    : p.group === 'specialist'
      ? 'Образование и опыт'
      : 'Карьера и достижения';

const split = (p: Person) => {
  const [surname, ...given] = p.name.split(' ');
  return { surname, given: given.join(' ') };
};
// the phone grid hides first names: a shared surname (the two Крейдиковых) shows its initial there
const surnames = [...coaches, ...specialists].map((p) => split(p).surname);
const ini = (p: Person) => {
  const n = split(p);
  return surnames.filter((s) => s === n.surname).length > 1 ? `${n.given[0]}.` : '';
};
---

<section class="team section" id="trenery" aria-labelledby="team-title">
  <div class="wrap">
    <div class="team__intro">
      <div class="team__lead">
        <h2 class="team__title display" id="team-title">Кто тренирует</h2>
        <figure class="team__photo">
          <Image src={lineup} alt="Тренеры Ice Hockey Life в строю на льду арены" widths={[640, 1024, 1600]} sizes="(min-width: 901px) 40vw, 94vw" loading="lazy" />
          <figcaption>{t('Тренерский штаб Ice Hockey Life на льду арены в Сириусе')}</figcaption>
        </figure>
      </div>
      <div class="letter">
        <div class="letter__text">
          <p>{t('Сборы ведёт Максим Сергеевич Крейдиков. С 2018 года он тренирует детские команды в Сочи — «Союз», потом «Черномор» — и провёл больше 30 смен в хоккейных кэмпах тренером и главным тренером.')}</p>
          <blockquote class="letter__quote">
            <p>{t('«Ни один тренер не может гарантировать вам того, что ваш ребёнок заиграет. Но вы можете приехать в наш кэмп, и мы будем работать на результат»')}</p>
            <footer>{t('Из Telegram-канала сборов, 22 октября 2024 года')}</footer>
          </blockquote>
          <p>
            {t('Сомневаетесь, подойдут ли сборы вашему ребёнку по возрасту и уровню, — позвоните Максиму Сергеевичу:')}
            <a class="nowrap" href={`tel:${contacts.headCoach.tel}`}>{contacts.headCoach.phone}</a>
          </p>
        </div>
      </div>
    </div>

    <ul class="team__head" role="list">
      {
        head.map((p) => {
          const n = split(p);
          return (
            <li>
              <button class="card card--big" type="button" data-sheet-open={`trener-${p.slug}`} aria-haspopup="dialog">
                <span class="card__photo">
                  <Image src={portrait(p.photo)} alt="" widths={[320, 520, 640]} sizes="(min-width: 900px) 30vw, 92vw" loading="lazy" />
                </span>
                <span class="card__body">
                  <span class="card__name">
                    <b class="display">{n.surname}</b>
                    <span>{n.given}</span>
                  </span>
                  <span class="card__role">{t(p.roleShort ?? p.role)}</span>
                  {p.highlight && <span class="card__fact">{t(p.highlight)}</span>}
                  <span class="card__more">{t(more(p))}</span>
                </span>
              </button>
            </li>
          );
        })
      }
    </ul>

    <ul class="team__grid team__grid--row" role="list">
      {
        rest.map((p) => {
          const n = split(p);
          const Tag = p.bio ? 'button' : 'div';
          return (
            <li>
              <Tag
                class:list={['card', !p.bio && 'card--static']}
                type={p.bio ? 'button' : undefined}
                data-sheet-open={p.bio ? `trener-${p.slug}` : undefined}
                aria-haspopup={p.bio ? 'dialog' : undefined}
              >
                <span class="card__photo" style={p.zoom ? `--zoom: ${p.zoom}` : undefined}>
                  <Image src={portrait(p.photo)} alt="" widths={[240, 400]} sizes="(min-width: 1100px) 22vw, (min-width: 640px) 30vw, 46vw" loading="lazy" />
                </span>
                <span class="card__body">
                  <span class="card__name">
                    <b class="display">{n.surname}{ini(p) && <span class="card__ini">{` ${ini(p)}`}</span>}</b>
                    <span>{n.given}</span>
                  </span>
                  <span class="card__role">{t(p.roleShort ?? p.role)}</span>
                  {p.highlight && <span class="card__fact">{t(p.highlight)}</span>}
                  {p.bio && <span class="card__more">{t(more(p))}</span>}
                </span>
              </Tag>
            </li>
          );
        })
      }
    </ul>

    <h3 class="team__sub display">{t('Специалисты вне льда')}</h3>
    <ul class="team__grid team__grid--spec" role="list">
      {
        specialists.map((p) => {
          const n = split(p);
          return (
            <li>
              <button class="card card--spec" type="button" data-sheet-open={`trener-${p.slug}`} aria-haspopup="dialog">
                <span class="card__photo">
                  <Image src={portrait(p.photo)} alt="" widths={[240, 400]} sizes="(min-width: 1100px) 18vw, (min-width: 640px) 30vw, 46vw" loading="lazy" />
                </span>
                <span class="card__body">
                  <span class="card__name">
                    <b class="display">{n.surname}{ini(p) && <span class="card__ini">{` ${ini(p)}`}</span>}</b>
                    <span>{n.given}</span>
                  </span>
                  <span class="card__role">{t(p.roleShort ?? p.role)}</span>
                  {p.highlight && <span class="card__fact">{t(p.highlight)}</span>}
                  <span class="card__more">{t(more(p))}</span>
                </span>
              </button>
            </li>
          );
        })
      }
    </ul>
    <p class="team__note" data-until={camp.overAfter}>{t(`Состав тренеров на смену ${camp.datesHuman} года подтвердит координатор.`)}</p>
  </div>

  {
    // one sheet per person with a bio; «предыдущий / следующий» walk through all of them in roster order
    withBio.map((p, i) => (
      <BioSheet person={p} portrait={portrait(p.photo)} prev={withBio[(i - 1 + withBio.length) % withBio.length]} next={withBio[(i + 1) % withBio.length]} />
    ))
  }
</section>

<style>
  .team__intro { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(24px, 5vw, 88px); align-items: start; }
  .team__title { font-size: var(--fs-h2); color: var(--c-blue-deep); }

  .letter { display: block; }
  .letter__text { display: grid; gap: 12px; font-size: var(--fs-lead); line-height: 1.5; color: var(--c-ink); max-width: 52ch; }
  .letter__text a { font-weight: 600; }
  .letter__quote { margin: 4px 0; padding-left: 18px; border-left: 2px solid var(--c-red-line); }
  .letter__quote p { font-weight: 600; }
  .letter__quote footer { margin-top: 6px; font-size: var(--fs-small); color: var(--c-ink-3); }

  /* cards: uniform portraits on the jersey-blue surface */
  .card {
    display: grid; grid-template-rows: auto 1fr; width: 100%; height: 100%; padding: 0; text-align: left;
    border: 0; background: none; color: inherit; font: inherit;
  }
  button.card { cursor: pointer; }
  .card__photo { display: block; background: var(--c-blue-deep); border-radius: var(--r-s); overflow: hidden; aspect-ratio: 4 / 5; }
  .card__photo img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
  /* source crops differ: --zoom brings every head in the 3 × 3 roster to the same size (staff.ts) */
  .team__grid--row .card__photo img { transform: scale(var(--zoom, 1)); transform-origin: 50% 8.5%; }
  .card__body { display: grid; align-content: start; gap: 6px; padding-top: 14px; }
  .card__role { font-size: var(--fs-small); font-weight: 600; color: var(--c-red-line); line-height: 1.3; margin-top: 2px; }
  .card__name { display: grid; }
  .card__name b { font-size: clamp(1.9rem, 1.5rem + 1.2vw, 2.6rem); line-height: .95; color: var(--c-ink); }
  .card__name > span { font-size: var(--fs-small); color: var(--c-ink-2); margin-top: 2px; }
  .card__ini { display: none; }
  .card__fact { font-size: var(--fs-small); color: var(--c-ink-2); line-height: 1.4; margin-top: 4px; }
  .card__more {
    margin-top: 6px; font-weight: 600; font-size: var(--fs-small); color: var(--c-blue-line);
    text-decoration: underline; text-underline-offset: .2em; text-decoration-thickness: 1px;
  }
  @media (hover: hover) {
    button.card:hover .card__more { text-decoration-thickness: 2px; }
    button.card:hover .card__name b { color: var(--c-blue-line); }
  }
  button.card:focus-visible { outline: none; }
  button.card:focus-visible .card__photo { outline: 3px solid var(--c-red-line); outline-offset: 3px; }

  /* the staff photo fills the column under the heading instead of leaving it empty */
  .team__photo { margin-top: clamp(24px, 3vw, 40px); }
  .team__photo img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; object-position: center 92%; border-radius: var(--r-s); }
  .team__photo figcaption { margin-top: 10px; font-size: var(--fs-small); color: var(--c-ink-2); }
  .team__head { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 2.4vw, 36px); margin-top: clamp(40px, 5vw, 72px); }
  .card--big .card__name b { font-size: clamp(2.4rem, 1.8rem + 2vw, 3.6rem); }
  .card--big .card__fact { font-size: var(--fs-body); color: var(--c-ink); }

  .team__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(24px, 2.6vw, 40px) clamp(14px, 2vw, 28px); margin-top: clamp(40px, 5vw, 64px); }
  /* the other nine coaches: compact horizontal cards, 3 × 3 */
  .team__grid--row { grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 2.4vw, 36px) clamp(16px, 2.4vw, 36px); }
  .team__grid--row .card { grid-template-columns: 38% 1fr; grid-template-rows: none; gap: 16px; align-items: start; }
  .team__grid--row .card__body { padding-top: 2px; }
  .team__grid--row .card__name b { font-size: clamp(1.6rem, 1.3rem + .9vw, 2.15rem); }
  .team__sub { font-size: var(--fs-h3); color: var(--c-blue-deep); margin-top: clamp(48px, 6vw, 88px); padding-top: 22px; border-top: 1px solid var(--c-hair-2); }
  .team__grid--spec { grid-template-columns: repeat(5, 1fr); margin-top: 28px; }
  .team__note { margin-top: clamp(24px, 3vw, 40px); font-size: var(--fs-small); color: var(--c-ink-3); }

  @media (max-width: 1080px) {
    .team__grid--spec { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 900px) {
    .team__intro { grid-template-columns: 1fr; }
    .team__head { grid-template-columns: 1fr; }
    .card--big { grid-template-columns: 42% 1fr; grid-template-rows: none; gap: 16px; align-items: start; }
    .card--big .card__body { padding-top: 0; }
    .team__grid { grid-template-columns: repeat(2, 1fr); }
    .team__grid--row { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .team__grid--row, .team__grid--spec { grid-template-columns: repeat(3, 1fr); gap: 20px 12px; }
    .team__grid--row .card, .card--spec { grid-template-columns: none; grid-template-rows: auto 1fr; gap: 0; }
    .team__grid .card__body { padding-top: 8px; gap: 2px; }
    .team__grid .card__fact, .team__grid .card__name > span, .team__grid .card__more { display: none; }
    .team__grid .card__ini { display: inline; }
    /* the cards with a bio carry a small «+» on the photo: the two without one read as plain cards */
    .team__grid button.card .card__photo { position: relative; }
    .team__grid button.card .card__photo::after {
      content: ''; position: absolute; right: 6px; bottom: 6px; width: 24px; height: 24px; border-radius: 50%;
      background:
        linear-gradient(var(--c-blue-deep), var(--c-blue-deep)) center / 10px 2px no-repeat,
        linear-gradient(var(--c-blue-deep), var(--c-blue-deep)) center / 2px 10px no-repeat,
        var(--c-board);
      box-shadow: 0 1px 3px rgb(11 30 63 / .3);
    }
    .team__grid .card__name b { font-size: 1.3rem; }
    .team__grid .card__role { font-size: .78rem; }
    .letter__text { font-size: var(--fs-body); }
  }
</style>
