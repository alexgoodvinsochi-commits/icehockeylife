---
// Share-image composition (1200×630). scripts/make-og.mjs screenshots this page into public/og.jpg.
import { Image, Font } from 'astro:assets';
import '../styles/base.css';
import skater from '../assets/cutouts/skater.png';
import logo from '../assets/brand/logo.svg?raw';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>og</title>
    <Font cssVariable="--font-text" />
    <style is:global>
      html, body { margin: 0; background: var(--c-ice); }
      .og { position: relative; width: 1200px; height: 630px; overflow: hidden; background: var(--c-ice); }
      .og__circle { position: absolute; right: 40px; top: 50%; translate: 0 -50%; width: 560px; }
      .og__skater { position: absolute; right: -10px; top: 50%; translate: 0 -50%; width: 640px; height: auto; }
      .og__text { position: absolute; left: 64px; top: 64px; width: 600px; }
      .og__title { font-family: var(--f-display); font-weight: 880; font-size: 92px; line-height: .9; color: var(--c-blue-deep); }
      .og__dates { display: flex; align-items: flex-end; gap: 18px; margin-top: 26px; }
      .og__dates b { font-family: var(--f-display); font-weight: 900; font-size: 150px; line-height: .78; color: var(--c-red-line); }
      .og__dates span { font-family: var(--f-display); font-weight: 800; font-size: 36px; line-height: 1; color: var(--c-ink); }
      .og__brand { position: absolute; left: 64px; bottom: 44px; display: flex; align-items: center; gap: 16px; }
      .og__brand div { width: 70px; fill: var(--c-blue-deep); }
      .og__brand p { font-family: var(--f-text); font-size: 22px; color: var(--c-ink-2); }
      .og__brand b { color: var(--c-ink); }
      .og__kick { position: absolute; left: 0; right: 0; bottom: 0; height: 12px; background: var(--c-kick); }
    </style>
  </head>
  <body>
    <div class="og">
      <svg class="og__circle" viewBox="-560 -560 1120 1120" aria-hidden="true">
        <circle r="450" fill="none" stroke="#C8102E" stroke-width="9"></circle>
        <g stroke="#C8102E" stroke-width="9">
          <line x1="-85" y1="-450" x2="-85" y2="-520"></line><line x1="85" y1="-450" x2="85" y2="-520"></line>
          <line x1="-85" y1="450" x2="-85" y2="520"></line><line x1="85" y1="450" x2="85" y2="520"></line>
        </g>
        <circle r="30" fill="#C8102E"></circle>
      </svg>
      <Image class="og__skater" src={skater} alt="" widths={[1000]} loading="eager" />
      <div class="og__text">
        <p class="og__title">Зимние хоккейные сборы в&nbsp;Сириусе</p>
        <p class="og__dates"><b>4–10</b><span>января 2027<br />ЛД «Большой»</span></p>
      </div>
      <div class="og__brand">
        <div set:html={logo}></div>
        <p><b>Ice Hockey Life</b> · 9 часов льда, 16 часов вне льда, группы по 5–6</p>
      </div>
      <div class="og__kick"></div>
    </div>
  </body>
</html>
