---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { contacts } from '../data/camp';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<Base title="Страница не найдена — Ice Hockey Life" description="Такой страницы на сайте Ice Hockey Life нет." noindex>
  <Header />
  <main id="main" class="nf">
    <div class="wrap">
      <p class="nf__code display" aria-hidden="true">404</p>
      <h1 class="nf__title display">Такой страницы нет</h1>
      <p class="nf__text">
        Возможно, ссылка устарела. Всё о&nbsp;зимних сборах&nbsp;— на&nbsp;главной, а если что-то не нашли, позвоните координатору:
        <a class="nowrap" href={`tel:${contacts.coordinator.tel}`}>{contacts.coordinator.phone}</a>.
      </p>
      <a class="btn btn--red nf__home" href={base}>На главную</a>
    </div>
  </main>
  <Footer />
</Base>

<script>
  import { initDialogs } from '../scripts/dialogs';
  initDialogs();
</script>

<style>
  .nf { padding-block: clamp(48px, 8vw, 120px); }
  .nf__code { font-size: clamp(6rem, 3rem + 12vw, 13rem); line-height: .8; color: var(--c-red-line); }
  .nf__title { margin-top: 20px; font-size: var(--fs-h2s); color: var(--c-blue-deep); }
  .nf__text { margin-top: 16px; max-width: 46ch; color: var(--c-ink-2); }
  .nf__home { margin-top: 28px; }
</style>
