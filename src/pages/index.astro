---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Facts from '../components/Facts.astro';
import Squad from '../components/Squad.astro';
import Program from '../components/Program.astro';
import Coaches from '../components/Coaches.astro';
import Price from '../components/Price.astro';
import Reviews from '../components/Reviews.astro';
import Geography from '../components/Geography.astro';
import Logistics from '../components/Logistics.astro';
import Video from '../components/Video.astro';
import Gallery from '../components/Gallery.astro';
import Faq from '../components/Faq.astro';
import Signup from '../components/Signup.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
---

<Base jsonLd>
  <Header />
  <main id="main">
    <Hero />
    <Squad />
    <Facts />
    <Program />
    <Coaches />
    <Price />
    <Logistics />
    <Reviews />
    <Video />
    <Gallery />
    <Geography />
    <Faq />
    <Signup />
  </main>
  <Footer />
  <MobileBar />
</Base>

<script>
  import { initDialogs } from '../scripts/dialogs';
  import { watchDates } from '../scripts/dates';
  import { initAnchors } from '../scripts/anchors';
  import { initCallGoals } from '../scripts/goals';
  // prices first: nothing that fails later may leave an expired offer on screen
  watchDates();
  initAnchors();
  initCallGoals();
  initDialogs();
</script>
