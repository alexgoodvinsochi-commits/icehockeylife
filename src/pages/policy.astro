---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { policy } from '../data/policy';
import { t } from '../lib/typo';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<Base title="Политика обработки персональных данных — Ice Hockey Life" description="Как Ice Hockey Life обрабатывает персональные данные из формы записи на хоккейные сборы.">
  <Header />
  <main id="main" class="doc">
    <div class="wrap doc__wrap">
      <p class="doc__back"><a href={base}>← На главную</a></p>
      <h1 class="doc__title display">{t(policy.title)}</h1>
      <p class="doc__date">Редакция от {policy.updated}</p>
      {
        policy.sections.map((s) => (
          <section class="doc__sec" id={s.id}>
            <h2>{t(s.title)}</h2>
            {s.body.map((p) => (Array.isArray(p) ? <ul>{p.map((li) => <li>{t(li)}</li>)}</ul> : <p>{t(p)}</p>))}
          </section>
        ))
      }
    </div>
  </main>
  <Footer />
</Base>

<script>
  import { initDialogs } from '../scripts/dialogs';
  initDialogs();
</script>

<style>
  .doc { padding-block: clamp(32px, 5vw, 80px) clamp(56px, 8vw, 120px); }
  .doc__wrap { max-width: 50rem; }
  .doc__back a { font-weight: 600; color: var(--c-blue-line); }
  .doc__title { margin-top: 20px; font-size: clamp(2.4rem, 1.6rem + 3.4vw, 4.4rem); color: var(--c-blue-deep); }
  .doc__date { margin-top: 12px; color: var(--c-ink-3); font-size: var(--fs-small); }
  .doc__sec { margin-top: 36px; }
  .doc__sec h2 { font-family: var(--f-display); font-weight: 800; font-size: 1.7rem; line-height: 1.05; padding-bottom: 10px; border-bottom: 3px solid var(--c-blue-line); }
  .doc__sec p, .doc__sec ul { margin-top: 12px; color: var(--c-ink-2); }
  .doc__sec ul { padding-left: 1.2em; }
  .doc__sec li + li { margin-top: 6px; }
</style>
