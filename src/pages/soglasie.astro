---
import LegalDoc from '../components/LegalDoc.astro';
import { consent } from '../data/legal';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<LegalDoc
  doc={consent}
  description="Текст согласия на обработку персональных данных для заявки на хоккейные сборы Ice Hockey Life и согласия на cookie."
  other={{ href: `${base}politika/`, label: 'Политика обработки персональных данных' }}
/>
